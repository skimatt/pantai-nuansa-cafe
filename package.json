{
  "name": "pantai-nuansa-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node tools/dev-with-photos.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-content.ts",
    "build": "npm run photos:sync && npm run licenses && npm run validate && next build && node tools/normalize-static-export.mjs",
    "test": "tsx --test tests/content.test.ts tests/local-photos.test.mjs",
    "test:e2e": "playwright test",
    "preview": "http-server out -a 127.0.0.1 -p 4173 -c-1 --silent",
    "assets:process": "node tools/process-images.mjs",
    "assets:validate": "npm run validate",
    "licenses": "node tools/license-report.mjs",
    "photos:sync": "node tools/sync-local-photos.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "^5.2.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.4",
    "http-server": "^14.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "three": "0.187.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
